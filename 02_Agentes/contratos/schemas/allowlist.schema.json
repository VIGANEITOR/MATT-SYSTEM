{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VIGANEITOR/MATT-SYSTEM/02_Agentes/contratos/schemas/allowlist.schema.json",
  "title": "MATTX — lista permitida de red controlada",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "aprobado_por",
    "fecha",
    "destinos"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "aprobado_por": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "destinos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre",
          "hosts",
          "uso",
          "requiere_credencial"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$"
          },
          "nombre": {
            "type": "string"
          },
          "hosts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
            }
          },
          "uso": {
            "type": "string"
          },
          "requiere_credencial": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
