{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VIGANEITOR/MATT-SYSTEM/02_Agentes/contratos/schemas/drenaje_input.json",
  "title": "Entrada de hidraulica.drenaje_pluvial",
  "description": "Brief Maestro v1.3 §14.1. Si falta un dataset obligatorio, la validación falla y el experimento pasa a \"esperando información\" (RF-07).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proyecto": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiccion_cumplimiento": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "crs_epsg": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "jurisdiccion_cumplimiento",
        "crs_epsg"
      ]
    },
    "pregunta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enunciado": {
          "type": "string",
          "minLength": 1
        },
        "hipotesis": {
          "type": "string",
          "minLength": 1
        },
        "criterio_aceptacion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enunciado",
        "hipotesis",
        "criterio_aceptacion"
      ]
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topografia": {
          "allOf": [
            {
              "$ref": "comunes.schema.json#/$defs/Dataset"
            },
            {
              "properties": {
                "formato": {
                  "enum": [
                    "GeoTIFF",
                    "LandXML",
                    "CSV"
                  ]
                }
              },
              "required": [
                "crs_epsg"
              ]
            }
          ]
        },
        "lluvia": {
          "allOf": [
            {
              "$ref": "comunes.schema.json#/$defs/Dataset"
            },
            {
              "properties": {
                "formato": {
                  "enum": [
                    "CSV"
                  ]
                }
              }
            }
          ]
        },
        "lluvia_metadatos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tipo": {
              "enum": [
                "IDF",
                "registros"
              ]
            },
            "estacion": {
              "type": "string",
              "minLength": 1
            },
            "periodo_registro": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "inicio": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "fin": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "inicio",
                "fin"
              ]
            }
          },
          "required": [
            "tipo",
            "estacion",
            "periodo_registro"
          ]
        },
        "catastro": {
          "allOf": [
            {
              "$ref": "comunes.schema.json#/$defs/Dataset"
            },
            {
              "properties": {
                "formato": {
                  "enum": [
                    "GeoPackage",
                    "Shapefile"
                  ]
                }
              },
              "required": [
                "crs_epsg"
              ]
            }
          ]
        },
        "coeficientes_escorrentia": {
          "$ref": "comunes.schema.json#/$defs/Dataset"
        }
      },
      "required": [
        "topografia",
        "lluvia",
        "lluvia_metadatos",
        "catastro",
        "coeficientes_escorrentia"
      ]
    },
    "criterios_diseno": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "norma_cumplimiento": {
          "allOf": [
            {
              "$ref": "comunes.schema.json#/$defs/Norma"
            },
            {
              "properties": {
                "rol": {
                  "const": "cumplimiento"
                }
              }
            }
          ]
        },
        "referencias": {
          "type": "array",
          "items": {
            "$ref": "comunes.schema.json#/$defs/Norma"
          }
        },
        "periodo_retorno": {
          "$ref": "comunes.schema.json#/$defs/Cantidad"
        },
        "velocidad_minima": {
          "$ref": "comunes.schema.json#/$defs/Cantidad"
        },
        "velocidad_maxima": {
          "$ref": "comunes.schema.json#/$defs/Cantidad"
        },
        "relacion_tirante_diametro_max": {
          "$ref": "comunes.schema.json#/$defs/Cantidad"
        }
      },
      "required": [
        "norma_cumplimiento",
        "periodo_retorno",
        "velocidad_minima",
        "velocidad_maxima",
        "relacion_tirante_diametro_max"
      ]
    },
    "escenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "periodo_retorno": {
            "$ref": "comunes.schema.json#/$defs/Cantidad"
          }
        },
        "required": [
          "id",
          "periodo_retorno"
        ]
      }
    },
    "sensibilidad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parametros": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nombre": {
                "enum": [
                  "intensidad_lluvia",
                  "coeficiente_escorrentia"
                ]
              },
              "variacion_relativa": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "nombre",
              "variacion_relativa"
            ]
          }
        }
      },
      "required": [
        "parametros"
      ]
    },
    "semilla": {
      "type": "integer",
      "minimum": 0
    },
    "supuestos": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notas": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "proyecto",
    "pregunta",
    "datasets",
    "criterios_diseno",
    "escenarios"
  ]
}
