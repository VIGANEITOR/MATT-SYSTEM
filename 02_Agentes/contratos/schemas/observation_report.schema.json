{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VIGANEITOR/MATT-SYSTEM/02_Agentes/contratos/schemas/observation_report.schema.json",
  "title": "MATTX — informe de observación",
  "description": "Brief de Implementación v2.2 §13. Un observador propone; no decide. El esquema no admite campos de decisión ni de aprobación.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "observer",
    "release",
    "fecha",
    "artefactos_observados",
    "hallazgos"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "observer": {
      "$ref": "comunes.schema.json#/$defs/AgenteRef"
    },
    "release": {
      "type": "string",
      "pattern": "^R[0-9]+(\\.[0-9]+)?\\+?$"
    },
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "artefactos_observados": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "comunes.schema.json#/$defs/Sha256"
      }
    },
    "hallazgos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tipo",
          "severidad_sugerida",
          "descripcion",
          "evidencia",
          "recomendacion",
          "confianza"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "enum": [
              "posible_error",
              "riesgo",
              "brecha",
              "inconsistencia_normativa",
              "mejora"
            ]
          },
          "severidad_sugerida": {
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4"
            ]
          },
          "descripcion": {
            "type": "string",
            "minLength": 1
          },
          "evidencia": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artefacto",
              "ubicacion"
            ],
            "properties": {
              "artefacto": {
                "$ref": "comunes.schema.json#/$defs/Sha256"
              },
              "ubicacion": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "recomendacion": {
            "type": "string",
            "minLength": 1
          },
          "confianza": {
            "enum": [
              "alta",
              "media",
              "baja"
            ]
          },
          "valores": {
            "type": "array",
            "items": {
              "$ref": "comunes.schema.json#/$defs/Cantidad"
            },
            "description": "Valores que respaldan un posible error numérico; un valor Calculado exige su ejecución"
          },
          "ejecucion_observador": {
            "type": "string",
            "minLength": 1,
            "description": "Ejecución propia en sandbox P0 aislado; nunca alimenta resultados del proyecto"
          }
        }
      }
    },
    "resumen": {
      "type": "string",
      "minLength": 1
    }
  }
}
