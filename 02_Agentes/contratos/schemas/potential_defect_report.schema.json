{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VIGANEITOR/MATT-SYSTEM/02_Agentes/contratos/schemas/potential_defect_report.schema.json",
  "title": "MATTX — informe de defectos potenciales (observador)",
  "description": "Brief de Implementación v2.3 §13. Un observador reporta defectos potenciales con evidencia y prioridad; no ejecuta, no modifica y no decide. El esquema no admite campos de decisión, aprobación ni ejecución propia.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "observer",
    "release",
    "fecha",
    "artefactos_observados",
    "hallazgos"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "observer": {
      "$ref": "comunes.schema.json#/$defs/AgenteRef"
    },
    "release": {
      "type": "string",
      "pattern": "^R[0-9]+(\\.[0-9]+)?\\+?$"
    },
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "artefactos_observados": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "comunes.schema.json#/$defs/Sha256"
      }
    },
    "hallazgos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tipo",
          "severidad_sugerida",
          "prioridad_sugerida",
          "descripcion",
          "evidencia",
          "recomendacion",
          "confianza"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "enum": [
              "posible_error",
              "riesgo_seguridad",
              "brecha_trazabilidad",
              "inconsistencia_normativa",
              "inconsistencia_documental"
            ]
          },
          "severidad_sugerida": {
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4"
            ]
          },
          "descripcion": {
            "type": "string",
            "minLength": 1
          },
          "evidencia": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artefacto",
              "ubicacion",
              "esperado",
              "observado"
            ],
            "properties": {
              "artefacto": {
                "$ref": "comunes.schema.json#/$defs/Sha256"
              },
              "ubicacion": {
                "type": "string",
                "minLength": 1
              },
              "esperado": {
                "type": "string",
                "minLength": 1
              },
              "observado": {
                "type": "string",
                "minLength": 1
              },
              "ejecuciones_referenciadas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Solo ejecuciones ya existentes; el observador no ejecuta"
              }
            }
          },
          "recomendacion": {
            "type": "string",
            "minLength": 1
          },
          "confianza": {
            "enum": [
              "alta",
              "media",
              "baja"
            ]
          },
          "valores": {
            "type": "array",
            "items": {
              "$ref": "comunes.schema.json#/$defs/Cantidad"
            },
            "description": "Valores que respaldan un posible error numérico; un valor Calculado exige su ejecución"
          },
          "prioridad_sugerida": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "requiere_reproduccion": {
            "type": "boolean"
          }
        }
      }
    },
    "resumen": {
      "type": "string",
      "minLength": 1
    },
    "reemplaza_a": {
      "$ref": "comunes.schema.json#/$defs/Sha256",
      "description": "Hash del informe anterior que este corrige (los informes son inmutables)"
    }
  }
}
